  "notes": [
    "Search label has no for attribute; use stable #lastName in POM.",
    "Input fragments provide server-side field errors with .help-inline, no required attributes.",
    "Owner form fields: firstName,lastName,address,city,telephone. Pet form: name,birthDate,type. Visit form: date,description.",
    "No custom external JS files exist. Bootstrap collapse plus owner detail inline timer are only UI scripts.",
    "Visit previous rows require !visit.new and therefore may not render on initial new form.",
    "Current pagination page and boundary arrows become spans instead of clickable links.",
    "Mobile navbar requires narrow viewport."
  ]
